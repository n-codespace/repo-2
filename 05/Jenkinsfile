pipeline {
    agent any

    environment {
        PYTHON_APP = 'calculator.py'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== Stage 1: Checking out Python project from Git ==='
                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                echo '=== Stage 2: Validating Python Runtime ==='
                script {
                    if (isUnix()) {
                        sh 'python3 --version || python --version'
                    } else {
                        bat 'python --version'
                    }
                }
            }
        }

        stage('Unit Testing') {
            steps {
                echo '=== Stage 3: Running Automated Python Unit Tests ==='
                script {
                    if (isUnix()) {
                        sh 'python3 -m unittest 05/test_calculator.py -v || python -m unittest test_calculator.py -v'
                    } else {
                        bat 'python -m unittest 05/test_calculator.py -v || python -m unittest test_calculator.py -v'
                    }
                }
            }
        }

        stage('Build & Run') {
            steps {
                echo '=== Stage 4: Executing Python Application ==='
                script {
                    if (isUnix()) {
                        sh 'python3 05/calculator.py || python calculator.py'
                    } else {
                        bat 'python 05/calculator.py || python calculator.py'
                    }
                }
            }
        }
    }

    post {
        always {
            echo '=== Pipeline Execution Finished ==='
        }
        success {
            echo 'SUCCESS: All pipeline stages completed cleanly!'
        }
        failure {
            echo 'FAILURE: One or more stages failed. Check console log.'
        }
    }
}
