// ==============================================================================
// Simple Jenkins Scripted Pipeline (Groovy DSL)
// Runs on a node, tests the JavaScript code, and executes the app.
// ==============================================================================

node {
    stage('1. Checkout Code') {
        echo 'Step 1: Pulling latest code from Git...'
        checkout scm
    }

    stage('2. Run Automated Tests') {
        echo 'Step 2: Running JavaScript unit tests...'
        if (isUnix()) {
            sh 'node --test 06/test_app.js || node --test test_app.js'
        } else {
            bat 'node --test 06/test_app.js || node --test test_app.js'
        }
    }

    stage('3. Run Application') {
        echo 'Step 3: Running application...'
        if (isUnix()) {
            sh 'node 06/app.js || node app.js'
        } else {
            bat 'node 06/app.js || node app.js'
        }
    }

    stage('4. Pipeline Finished') {
        echo '>>> SUCCESS: Jenkins Scripted Pipeline finished successfully! <<<'
    }
}
