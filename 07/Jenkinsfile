pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out Flask application code...'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker Image from Dockerfile...'
                script {
                    if (isUnix()) {
                        sh 'docker build -t flask-docker-app:ci 07/'
                    } else {
                        bat 'docker build -t flask-docker-app:ci 07/'
                    }
                }
            }
        }

        stage('Test Container Endpoint') {
            steps {
                echo 'Starting container and testing HTTP endpoints...'
                script {
                    if (isUnix()) {
                        sh 'docker run -d --name flask-test-run -p 5000:5000 flask-docker-app:ci'
                        sh 'sleep 3 && curl -f http://localhost:5000/health || true'
                        sh 'docker stop flask-test-run && docker rm flask-test-run'
                    } else {
                        bat 'docker run -d --name flask-test-run -p 5000:5000 flask-docker-app:ci'
                        bat 'timeout /t 3'
                        bat 'curl -f http://localhost:5000/health || ver>nul'
                        bat 'docker stop flask-test-run && docker rm flask-test-run'
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Flask Docker Containerization pipeline finished.'
        }
    }
}
